{
  "name": "binhi",
  "private": true,
  "version": "0.1.0",
  "description": "BINHI \u2014 standalone visual website editor and publishing platform (CHAOS ORIGINS). Independently operable; integrates with ORIGIN through contracts only.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server/start.ts",
    "dev:client": "vite",
    "start": "node dist/server/start.js",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "node --import tsx e2e/run.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/server/db/migrate.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.1",
    "@fastify/static": "^8.0.1",
    "drizzle-orm": "^0.36.1",
    "fastify": "^5.0.0",
    "postgres": "^3.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "drizzle-kit": "^0.28.0",
    "playwright": "^1.56.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.4"
  }
}
