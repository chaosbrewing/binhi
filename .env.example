# BINHI — standalone visual website editor. Copy to apps/binhi/.env.
# BINHI never reads ORIGIN or MAYARI variables: it has its own database,
# its own session secret and its own public URL.

# Postgres connection for BINHI (required). Keep development and production separate.
BINHI_DATABASE_URL=postgres://binhi:binhi_dev_pw@127.0.0.1:5432/binhi_dev

# 32+ random bytes, hex. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BINHI_SESSION_SECRET=change-me

# Public base URL of this deployment. Published sites live under <BINHI_PUBLIC_URL>/s/<slug>/.
# Publication verification fetches this URL, so it must be reachable from the server itself.
BINHI_PUBLIC_URL=http://127.0.0.1:4100

# Port the Fastify server listens on.
BINHI_PORT=4100

# "production" enables Secure cookies and serves the built client from dist/client.
NODE_ENV=development

# Media storage: "postgres" (default, durable with the database) or "disk".
# BINHI_MEDIA_DIR is only used by the disk adapter and must be a persistent volume.
BINHI_MEDIA_STORAGE=postgres
# BINHI_MEDIA_DIR=/var/lib/binhi/media

# Optional: disable new account creation on a private deployment.
# BINHI_ALLOW_SIGNUP=true
