modules = ["nodejs-20", "web"]

[nix]
channel = "stable-25_05"

run = "npm run dev"

[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "npm ci && npm run build"]
run = ["sh", "-c", "NODE_ENV=production node dist/server/start.js"]

[[ports]]
localPort = 4100
externalPort = 80

[env]
BINHI_PORT = "4100"
